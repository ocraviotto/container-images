{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update packages in Dockerfile ARGs with comment",
      "managerFilePatterns": [
        "images/**/Dockerfile"
      ],
      "matchStrings": [
        "# renovate:(?: packageName=(?<packageName>\\S+?))(?: depName=(?<depName>\\S+?))?(?: datasource=(?<datasource>\\S+))?(?: versioning=(?<versioning>[a-z-]+?))?\\nARG\\s\\S+_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update images' .version files",
      "managerFilePatterns": [
        "images/**/.version"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    },
    {
      "customType": "regex",
      "description": "Update ente-server commit hash from API for ref",
      "managerFilePatterns": [
        "/^specs/ente.yml$/"
      ],
      "matchStrings": [
        "ref:\\s*(?<currentDigest>[a-f0-9]{40}) # ente-commit"
      ],
      "depNameTemplate": "ente-server-commit",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.enteServer",
      "currentValueTemplate": "0.0.0",
      "autoReplaceStringTemplate": "ref: {{{ newDigest }}} # ente-commit"
    },
    {
      "customType": "regex",
      "description": "Update ente-server commit hash from API for args",
      "managerFilePatterns": [
        "/^specs/ente.yml$/"
      ],
      "matchStrings": [
        "- GIT_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "ente-server-args",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.enteServer",
      "currentValueTemplate": "0.0.0",
      "autoReplaceStringTemplate": "- GIT_COMMIT={{{ newDigest }}}"
    },
    {
      "customType": "regex",
      "description": "Update plandex-server version",
      "managerFilePatterns": [
        "/^specs/plandex.yml$/"
      ],
      "matchStrings": [
        "ref: \"server/(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "imageTags: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "plandex-ai/plandex",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^server/(?<version>.*)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update gpt-researcher version",
      "managerFilePatterns": [
        "/^specs/gpt-researcher.yml$/"
      ],
      "matchStrings": [
        "ref: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "imageTags: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "assafelovic/gpt-researcher",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Moyai commit hash from API for ref",
      "managerFilePatterns": [
        "/^specs/moyai\\.yml$/"
      ],
      "matchStrings": [
        "ref:\\s*(?<currentDigest>[a-f0-9]{40}) # moyai-commit"
      ],
      "depNameTemplate": "moyai-commit",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.moyaiCommit",
      "currentValueTemplate": "0.0.0",
      "autoReplaceStringTemplate": "ref: {{{ newDigest }}} # moyai-commit"
    },
    {
      "customType": "regex",
      "description": "Update contour-authserver main commit in the image Dockerfile",
      "managerFilePatterns": [
        "/^images/contour-authserver/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: contour-authserver-commit\\nARG CONTOUR_AUTHSERVER_VERSION=(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "contour-authserver-commit",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.contourAuthserverCommit",
      "currentValueTemplate": "0.0.0",
      "autoReplaceStringTemplate": "# renovate: contour-authserver-commit\nARG CONTOUR_AUTHSERVER_VERSION={{{ newDigest }}}"
    },
    {
      "customType": "regex",
      "description": "Update contour-authserver main commit in the image .version file",
      "managerFilePatterns": [
        "/^images/contour-authserver/\\.version$/"
      ],
      "matchStrings": [
        "# renovate: contour-authserver-commit\\nCONTOUR_AUTHSERVER_VERSION=(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "contour-authserver-commit",
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.contourAuthserverCommit",
      "currentValueTemplate": "0.0.0",
      "autoReplaceStringTemplate": "# renovate: contour-authserver-commit\nCONTOUR_AUTHSERVER_VERSION={{{ newDigest }}}"
    }
  ],
  "customDatasources": {
    "enteServer": {
      "defaultRegistryUrlTemplate": "https://api.ente.io/ping",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": \"0.0.0\", \"digest\": id}]}"
      ]
    },
    "moyaiCommit": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/BerriAI/moyai/commits/main",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": \"0.0.0\", \"digest\": sha}]}"
      ]
    },
    "contourAuthserverCommit": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/projectcontour/contour-authserver/commits/main",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": \"0.0.0\", \"digest\": sha}]}"
      ]
    },
    "crunchyPostgres": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/CrunchyData/postgres-operator/main/config/components/images-by-tag/kustomization.yaml",
      "format": "yaml",
      "transformTemplates": [
        "{\"releases\":[{\"version\": images[name = \"{{packageName}}\"].newTag}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Moyai dropped Substrate + Dockerfile.sandbox in #480; pin to cf1844f until Substrate returns upstream.",
      "matchDatasources": [
        "custom.moyaiCommit"
      ],
      "enabled": false
    },
    {
      "description": "Contour authserver has no release tags newer than v4; track the main branch commit.",
      "matchDatasources": [
        "custom.contourAuthserverCommit"
      ],
      "groupName": "Contour Authserver (automatic)"
    },
    {
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Github Actions Dependencies (non-major)"
    },
    {
      "matchFileNames": [
        "/^specs/ente.yml$/"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "groupName": "Ente (automatic)"
    },
    {
      "matchFileNames": [
        "images/**",
        "specs/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Build Updates (non-major)"
    },
    {
      "description": "mem0 v2.2.1 pins pydantic==2.10.4 -> pydantic-core 2.27.2 (pyo3 0.22), which has no Python 3.14/3.15 wheels and cannot compile on newer interpreters; hold the 3.13 line until mem0 relaxes the pin.",
      "matchFileNames": [
        "images/mem0-api/Dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.13/"
    },
    {
      "matchDatasources": [
        "custom.crunchyPostgres"
      ],
      "versioning": "regex:^(?<compatibility>ubi9-\\d+)\\.(?<minor>\\d+)-(?<build>\\d+)$"
    }
  ]
}
