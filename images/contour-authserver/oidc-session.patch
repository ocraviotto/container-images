+// getProvider returns the cached OIDC provider, discovering it on first use.
+// Discovery deliberately does not use the ext_authz request context: Contour
+// cancels that context at its authorization responseTimeout, which aborts the
+// IdP round trip and previously left o.provider nil (and panicking). Running it
+// on a background context with its own deadline makes the result independent of
+// any single request, and caching it stops per-request re-discovery.
+func (o *OIDCConnect) getProvider() (*oidc.Provider, error) {
+	o.providerMu.Lock()
+	defer o.providerMu.Unlock()
+
+	if o.provider != nil {
+		return o.provider, nil
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+
+	provider, err := o.initProvider(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	o.provider = provider
+	return provider, nil
+}
